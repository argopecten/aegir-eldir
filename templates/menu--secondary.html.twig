{% macro menu_links(items, attributes, menu_level) %}
  {% if items %}
    {% if menu_level == 0 %}
      <ul{{ attributes.addClass('links', 'inline').setAttribute('id', 'secondary-menu') }}>
    {% else %}
      <ul class="menu">
    {% endif %}
    {% for item in items %}
      {% set classes = [
        item.is_expanded ? 'expanded',
        item.is_collapsed ? 'collapsed',
        item.in_active_trail ? 'active-trail',
        item.in_active_trail ? 'active'
      ] %}
      <li{{ item.attributes.addClass(classes) }}>
        {{ link(item.title, item.url) }}
        {% if item.below %}
          {{ _self.menu_links(item.below, create_attribute(), menu_level + 1) }}
        {% endif %}
      </li>
    {% endfor %}
    </ul>
  {% endif %}
{% endmacro %}

{{ _self.menu_links(items, attributes, 0) }}
