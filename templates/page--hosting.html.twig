{#
/**
 * @file
 * Page template for all /hosting/* routes.
 *
 * Extends the default page template by always rendering a hosting sidebar
 * on the right, matching the D7 Aegir layout with Task Queue, Navigation,
 * and Queue Summary in the sidebar.
 *
 * Uses semantic HTML5 elements, ARIA landmarks, and Drupal 11 Twig
 * attributes patterns throughout.
 *
 * Available variables:
 * - All standard page.html.twig variables.
 * - hosting_sidebar: Render array for the hosting sidebar (built by
 *   HostingSidebarBuilder service and injected via preprocess).
 */
#}
<div id="page-wrapper">

  <header id="header" class="reverse" role="banner">
    <div class="limiter">
      {% if logo %}
      <a class="logo" href="{{ front_page }}" rel="home" aria-label="{{ 'Home'|t }}">
        <img src="{{ svg_logo|default(logo) }}" alt="{{ 'Home'|t }}" />
      </a>
      {% endif %}
      {% if site_name %}
        <span class="site-name">{{ site_name }}</span>
      {% endif %}
    </div>
  </header>

  <nav id="navigation" class="reverse" aria-label="{{ 'Main navigation'|t }}">
    <div class="limiter">
      {% if breadcrumb %}
        <nav class="breadcrumb" aria-label="{{ 'Breadcrumb'|t }}">
          {{ breadcrumb }}
        </nav>
      {% endif %}
      {% if page.navigation %}
        {{ page.navigation }}
      {% elseif main_menu %}
        {{ main_menu }}
      {% endif %}
    </div>
  </nav>

  {% if messages %}
  <div id="console" class="reverse" role="status" aria-live="polite" aria-atomic="true">
    <div class="limiter">
      {{ messages }}
    </div>
  </div>
  {% endif %}

  {% if page.header or title or tabs %}
  <div id="header-region">
    <div class="limiter">
      {{ page.header }}
      {{ title_prefix }}
      {% if title %}
        <h1 class="page-title">{{ title }}</h1>
      {% endif %}
      {{ title_suffix }}
      {% if tabs %}
        <nav class="tabs" aria-label="{{ 'Primary tabs'|t }}">
          {{ tabs }}
        </nav>
      {% endif %}
    </div>
  </div>
  {% endif %}

  <div id="page">
    <div class="limiter">
      {% if tabs2 %}
        <nav class="tabs tabs-secondary" aria-label="{{ 'Secondary tabs'|t }}">
          {{ tabs2 }}
        </nav>
      {% endif %}
      {% if action_links %}
        <nav class="action-links" aria-label="{{ 'Action links'|t }}">
          {{ action_links }}
        </nav>
      {% endif %}

      <main id="main" role="main">
        <a id="main-content" tabindex="-1"></a>
        <div class="page-content">
          {{ page.help }}
          {{ page.content }}
          {{ page.content_bottom }}
          {{ feed_icons }}
        </div>
      </main>

      {# Always render the hosting sidebar on /hosting/* pages #}
      {% if hosting_sidebar %}
        <aside id="right" class="sidebar" role="complementary" aria-label="{{ 'Hosting sidebar'|t }}">
          {{ hosting_sidebar }}
        </aside>
      {% elseif page.sidebar_first or page.sidebar_second %}
        <aside id="right" class="sidebar" role="complementary" aria-label="{{ 'Sidebar'|t }}">
          {{ page.sidebar_first }}
          {{ page.sidebar_second }}
        </aside>
      {% endif %}

    </div>
  </div>

  <footer id="footer" class="reverse" role="contentinfo">
    <div class="limiter">
      {{ page.footer }}
      {% if page.footer is empty and secondary_menu %}
        <nav aria-label="{{ 'Footer menu'|t }}">
          {{ secondary_menu }}
        </nav>
      {% endif %}
    </div>
  </footer>

</div>
