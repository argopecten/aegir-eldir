{#
/**
 * @file
 * Eldir theme override for hosting_task entities.
 *
 * Variables: task, label, task_type, status, command, args, options,
 *   started, completed, duration, view_mode, content, attributes.
 */
#}
{% set classes = [
  'hosting-task', 'hosting-entity',
  'hosting-task--' ~ status|clean_class,
  'hosting-task--type-' ~ task_type|clean_class,
  'hosting-task--' ~ view_mode|clean_class,
] %}
<article{{ attributes.addClass(classes) }}>
  <header class="hosting-task__header">
    {{ title_prefix }}
    {% if label %}
      <h2 class="hosting-task__title">
        {% if url %}
          <a href="{{ url }}" rel="bookmark">{{ label }}</a>
        {% else %}
          {{ label }}
        {% endif %}
      </h2>
    {% endif %}
    {{ title_suffix }}
    <div class="hosting-task__meta">
      {% if task_type %}
        <span class="hosting-task__type hosting-entity-chip">{{ task_type|capitalize }}</span>
      {% endif %}
      {% if status %}
        <span class="hosting-task__status hosting-task__status--{{ status|clean_class }} hosting-status-badge">
          {{ status|capitalize }}
        </span>
      {% endif %}
    </div>
  </header>
  <div class="hosting-task__content">
    {{ content }}
  </div>
</article>
