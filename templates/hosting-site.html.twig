{#
/**
 * @file
 * Eldir theme override for hosting_site entities.
 *
 * Variables: content, attributes, label, title_prefix/suffix,
 *   title_attributes, entity, view_mode, sidebar, info, tasks_view.
 */
#}
<article{{ attributes.addClass('hosting-site', 'hosting-entity', 'hosting-site--' ~ view_mode) }}>
  {% if sidebar %}
    <div class="hosting-entity-layout hosting-entity-layout--with-sidebar">
      <div class="hosting-entity-main">
        {{ title_prefix }}
        {% if label and not page %}
          <h2{{ title_attributes.addClass('hosting-entity__title') }}>
            <a href="{{ url }}" rel="bookmark">{{ label }}</a>
          </h2>
        {% endif %}
        {{ title_suffix }}

        {% if info %}
          <div class="hosting-entity__info">
            {{ info }}
          </div>
        {% endif %}

        {% if tasks_view %}
          <div class="hosting-entity__tasks">
            {{ tasks_view }}
          </div>
        {% endif %}

        <div class="hosting-entity__content">
          {{ content|without('sidebar') }}
        </div>
      </div>
      <aside class="hosting-entity-sidebar hosting-sidebar">
        {{ sidebar }}
      </aside>
    </div>
  {% else %}
    {{ title_prefix }}
    {% if label and not page %}
      <h2{{ title_attributes.addClass('hosting-entity__title') }}>
        <a href="{{ url }}" rel="bookmark">{{ label }}</a>
      </h2>
    {% endif %}
    {{ title_suffix }}

    {% if info %}
      <div class="hosting-entity__info">
        {{ info }}
      </div>
    {% endif %}

    {% if tasks_view %}
      <div class="hosting-entity__tasks">
        {{ tasks_view }}
      </div>
    {% endif %}

    <div class="hosting-entity__content">
      {{ content }}
    </div>
  {% endif %}
</article>
