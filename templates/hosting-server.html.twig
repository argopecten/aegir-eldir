<article{{ attributes }}>
  <header class="hosting-server-hero">
    <span class="hosting-entity-chip">{{ 'Server'|t }}</span>
    <h1 class="hosting-server-title">{{ label }}</h1>
  </header>

  <div class="hosting-server-layout">
    <div class="hosting-server-main">
      {{ content }}
    </div>
    <aside class="hosting-server-sidebar">
      {{ sidebar }}
    </aside>
  </div>
</article>
