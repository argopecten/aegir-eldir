<div id="auth_box" class="register">
  <div id="top_part">
    {% if logo %}
      <h1 id="the_logo">
        <a href="{{ front_page }}"><img src="{{ svg_logo|default(logo) }}" alt="{{ 'Home'|t }}" /></a>
      </h1>
    {% endif %}
  </div>

  <div id="middle_part">
    <h2 class="title">{{ title }}</h2>

    {{ messages }}

    {{ page.content }}
  </div>

  <div id="bottom_part">
    <div class="login_link">
      <a href="{{ path('user.login') }}">{{ 'Login'|t }}</a>
    </div>

    <div class="password_link">
      <a href="{{ path('user.pass') }}">{{ 'Forgot your password?'|t }}</a>
    </div>
  </div>
</div>
