<div id="page-wrapper">
  <div id="header" class="reverse"><div class="limiter clearfix">
      {% if theme_logo %}
      <div class="logo">
        <a href="{{ path('<front>') }}" rel="home">
          <img src="{{ theme_logo }}" alt="{{ 'Home'|t }}" fetchpriority="high" />
        </a>
      </div>
      {% endif %}
    {% if site_name %}
      <div class="site-name">
        <a href="{{ path('<front>') }}" rel="home">{{ site_name }}</a>
      </div>
    {% endif %}
  </div></div><!-- /header -->

  <div id="navigation" class="reverse"><div class="limiter clearfix">
    {% if page.breadcrumb is defined and page.breadcrumb %}
      {{ page.breadcrumb }}
    {% endif %}
    {% if page.primary_menu %}
      <nav id="main-menu" class="main-menu">{{ page.primary_menu }}</nav>
    {% endif %}
  </div></div>

  {% if messages is defined and messages %}
  <div id="console" class="reverse"><div class="limiter clearfix">
   {{ messages }}
  </div></div>
  {% endif %}

  <div id="header-region"><div class="limiter clearfix">
    {{ page.header }}
    {{ title_prefix }}
    {% if title %}<h2 class="page-title">{{ title }}</h2>{% endif %}
    {{ title_suffix }}
    {% if page.tabs is defined and page.tabs %}
      {{ page.tabs }}
    {% elseif primary_local_tasks is defined and primary_local_tasks %}
      {{ primary_local_tasks }}
    {% endif %}
  </div></div>

  <div id="page"><div class="limiter clearfix">
    {% if secondary_local_tasks is defined and secondary_local_tasks %}
      {{ secondary_local_tasks }}
    {% endif %}
    {% if action_links is defined and action_links %}
      {{ action_links }}
    {% endif %}

    <div id="main">
      <div class="page-content" id="main-content">
        {{ page.help }}
        {{ page.content }}
        {{ page.content_bottom }}
        {{ feed_icons }}
      </div>
    </div><!-- /main -->

    {% if page.sidebar_first or page.sidebar_second %}
      <div id="right" class="sidebar">
        {{ page.sidebar_first }}
        {{ page.sidebar_second }}
      </div>
    {% endif %}

  </div></div>

  <div id="footer" class="reverse"><div class="limiter">
    {{ page.footer }}
    {% if page.secondary_menu %}
      <nav id="secondary-menu" class="secondary-menu">{{ page.secondary_menu }}</nav>
    {% endif %}
  </div></div>
</div> <!-- /#page-wrapper -->
