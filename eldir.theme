/**
 * Implements hook_preprocess_form().
 */
function eldir_preprocess_form(array &$variables) {
  $form_id = $variables['form_id'] ?? '';
  if (str_starts_with($form_id, 'hosting_')) {
    $variables['attributes']['class'][] = 'hosting-form';
  }
}

/**
 * Implements hook_preprocess_form_element().
 */
function eldir_preprocess_form_element(array &$variables) {
  $form_id = $variables['element']['#form_id'] ?? '';
  if (is_string($form_id) && str_starts_with($form_id, 'hosting_')) {
    $variables['attributes']['class'][] = 'hosting-form__element';
  }
}



/**
 * Preprocesses variables for hosting_status_badge template.
 */
function eldir_preprocess_hosting_status_badge(array &$variables) {
  // Ensure attributes object exists
  if (!isset($variables['attributes']) || !is_array($variables['attributes'])) {
    $variables['attributes'] = [];
  }
  
  // Add default label if not provided
  if (empty($variables['label']) && !empty($variables['status'])) {
    $variables['label'] = ucfirst($variables['status']);
  }

  // Map status to SVG icon name from aegir-icons-sprite.svg.
  $icon_map = [
    'enabled' => 'icon-ok',
    'success' => 'icon-ok',
    'active' => 'icon-ok',
    'verified' => 'icon-ok',
    'disabled' => 'icon-disabled',
    'locked' => 'icon-disabled',
    'queued' => 'icon-queue',
    'processing' => 'icon-info',
    'error' => 'icon-error',
    'deleted' => 'icon-error',
    'warning' => 'icon-warning',
  ];
  $status = $variables['status'] ?? '';
  if (isset($icon_map[$status])) {
    $theme_path = \Drupal::service('extension.list.theme')->getPath('aegir_eldir');
    $sprite_url = base_path() . $theme_path . '/images/svg/aegir-icons-sprite.svg';
    $icon_name = $icon_map[$status];
    $variables['icon_svg'] = Markup::create(
      '<svg class="hosting-icon" aria-hidden="true"><use href="' . $sprite_url . '#' . $icon_name . '"></use></svg>'
    );
  }
}

/**
 * Preprocesses variables for hosting_panel template.
 */
function eldir_preprocess_hosting_panel(array &$variables) {
  // Ensure attributes object exists
  if (!isset($variables['attributes']) || !is_array($variables['attributes'])) {
    $variables['attributes'] = [];
  }
}

/**
 * Preprocesses variables for hosting_task_card template.
 */
function eldir_preprocess_hosting_task_card(array &$variables) {
  // Ensure attributes object exists
  if (!isset($variables['attributes']) || !is_array($variables['attributes'])) {
    $variables['attributes'] = [];
  }
  
  // Add live update data attribute for JavaScript
  if (!empty($variables['task_id'])) {
    $variables['attributes']['data-task-id'] = $variables['task_id'];
    $variables['attributes']['data-task-status'] = $variables['status'] ?? 'unknown';
  }
}

/**
 * Preprocesses variables for hosting_entity_chip template.
 */
function eldir_preprocess_hosting_entity_chip(array &$variables) {
  // Ensure attributes object exists
  if (!isset($variables['attributes']) || !is_array($variables['attributes'])) {
    $variables['attributes'] = [];
  }
  
  // Add entity data attributes
  if (!empty($variables['entity_type'])) {
    $variables['attributes']['data-entity-type'] = $variables['entity_type'];
  }
  if (!empty($variables['entity_id'])) {
    $variables['attributes']['data-entity-id'] = $variables['entity_id'];
  }
}

/**
 * Theme settings form.
 */
function eldir_form_system_theme_settings_alter(array &$form, FormStateInterface $form_state) {
  $form['eldir_settings'] = [
    '#type' => 'details',
    '#title' => t('Eldir theme settings'),
    '#open' => TRUE,
  ];

  $form['eldir_settings']['use_svg_logo'] = [
    '#type' => 'checkbox',
    '#title' => t('Prefer SVG logo'),
    '#default_value' => theme_get_setting('use_svg_logo'),
  ];

  $form['eldir_settings']['wide_layout'] = [
    '#type' => 'checkbox',
    '#title' => t('Enable wide layout'),
    '#default_value' => theme_get_setting('wide_layout'),
  ];

  $form['eldir_settings']['main_menu_name'] = [
    '#type' => 'textfield',
    '#title' => t('Main menu machine name'),
    '#default_value' => theme_get_setting('main_menu_name'),
    '#description' => t('Defaults to "main" if left blank.'),
  ];

  $form['eldir_settings']['secondary_menu_name'] = [
    '#type' => 'textfield',
    '#title' => t('Secondary menu machine name'),
    '#default_value' => theme_get_setting('secondary_menu_name'),
    '#description' => t('Defaults to "secondary" if left blank.'),
  ];
}

/**
 * Builds a menu render array by name.
 */
function eldir_build_menu($menu_name) {
  if (empty($menu_name)) {
    return [];
  }

  $menu_storage = \Drupal::entityTypeManager()->getStorage('menu');
  if (!$menu_storage->load($menu_name)) {
    return [];
  }

  $menu_tree = \Drupal::menuTree();
  $parameters = $menu_tree->getCurrentRouteMenuTreeParameters($menu_name);
  $route_match = \Drupal::routeMatch();
  $route_name = $route_match->getRouteName();
  if (str_starts_with($route_name, 'entity.hosting_') && str_ends_with($route_name, '.add_form')) {
    $parameters = new \Drupal\Core\Menu\MenuTreeParameters();
  }
  $tree = $menu_tree->load($menu_name, $parameters);
  $tree = $menu_tree->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  return $menu_tree->build($tree);
}

/**
 * Adds standard data attributes for hosting entities.
 */
function eldir_add_entity_metadata_attributes(array &$variables): void {
  $entity = $variables['entity'] ?? NULL;
  if (!$entity instanceof \Drupal\Core\Entity\EntityInterface) {
    return;
  }

  $attributes = &$variables['attributes'];
  $attributes['data-entity-type'] = $entity->getEntityTypeId();
  $attributes['data-entity-id'] = (string) $entity->id();

  $view_mode = $variables['elements']['#view_mode'] ?? '';
  if (is_string($view_mode) && $view_mode !== '') {
    $attributes['data-view-mode'] = $view_mode;
  }

  $bundle = $variables['elements']['#bundle'] ?? '';
  if (is_string($bundle) && $bundle !== '') {
    $attributes['data-entity-bundle'] = $bundle;
  }
}

/**
 * Preprocesses variables for hosting_site templates at theme level.
 *
 * Adds status-based CSS classes and data attributes.
 */
function eldir_preprocess_hosting_site(array &$variables): void {
  eldir_add_entity_metadata_attributes($variables);

  $site = $variables['site'] ?? $variables['entity'] ?? NULL;
  if ($site && method_exists($site, 'get')) {
    $status = (int) $site->get('status')->value;
    $status_map = [
      0 => 'queued',
      1 => 'enabled',
      -1 => 'disabled',
      -2 => 'deleted',
    ];
    $status_class = $status_map[$status] ?? 'unknown';
    $variables['attributes']['class'][] = 'hosting-site--' . $status_class;
    $variables['status_class'] = $status_class;
  }
}

