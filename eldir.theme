/**
 * Implements hook_preprocess_menu__main().
 */
function eldir_preprocess_menu__main(array &$variables) {
  $variables['attributes']['class'][] = 'hosting-main-menu';
}

/**
 * Implements hook_preprocess_menu_local_tasks().
 */
function eldir_preprocess_menu_local_tasks(array &$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (str_starts_with($route_name, 'hosting.') || str_starts_with($route_name, 'entity.hosting_')) {
    $variables['attributes']['class'][] = 'hosting-local-tasks';
  }
}

/**
 * Implements hook_preprocess_table().
 */
function eldir_preprocess_table(array &$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();
  if (str_starts_with($route_name, 'hosting.') || str_starts_with($route_name, 'entity.hosting_')) {
